# Reference only. Copy each app-specific example to its documented location.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://operations:operations@localhost:5432/operations
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000
# Web server only:
API_BASE_URL=http://localhost:4000

# Required secrets: generate with npm run setup:local for local development.
SESSION_SECRET=
BFF_SHARED_SECRET=
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
# Explicit, non-production-only fictional seed. Passwords are never committed.
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_EMAIL=manager@example.test
DEMO_MANAGER_PASSWORD=
DEMO_IT_EMAIL=it@example.test
DEMO_IT_PASSWORD=

# Milestone 3: local verification uses NODE_ENV=development/test only and example.test addresses.
# No static verification code or bypass secret. Run npm run verification:demo -- <reference>.
# Applicant cookie lifetime is 1 hour; challenge lifetime is 10 minutes.
# Production email delivery is not implemented; production verification fails closed.

# Optional one-time first administrator CLI (never startup/build/seed).
# Password is entered twice at a hidden interactive prompt, never in env/arguments.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# Ordinary local deployment (hosted real deployment must use production).
DEPLOYMENT_PURPOSE=local
DEMO_EMAIL_MODE=false
# Explicit admin-only starter conversion exception; never enables delivery by itself.
DEMO_STARTER_MODE=false
DEMO_FICTIONAL_DATA_ONLY=false
DEMO_DEPLOYMENT_ID=
DEMO_MAILBOX_KEY=
# Temporary starter demo: purpose=demo and all three demo flags=true, plus
# a UUID deployment ID and independent random base64 32-byte mailbox key.
# Reuse existing services only after guarded conversion; see docs/starter-demo.md.
