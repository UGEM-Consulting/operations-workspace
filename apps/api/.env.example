NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://operations:operations@localhost:5432/operations
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000

# Required secrets: generate with npm run setup:local for local development.
SESSION_SECRET=
BFF_SHARED_SECRET=
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
# Explicit, non-production-only fictional seed. Passwords are never committed.
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_EMAIL=manager@example.test
DEMO_MANAGER_PASSWORD=
DEMO_IT_EMAIL=it@example.test
DEMO_IT_PASSWORD=
DEMO_SAFETY_MANAGER_EMAIL=safety.manager@example.test
DEMO_SAFETY_MANAGER_PASSWORD=
DEMO_SAFETY_LEAD_EMAIL=safety.lead@example.test
DEMO_SAFETY_LEAD_PASSWORD=
DEMO_SAFETY_STAFF_EMAIL=safety.staff@example.test
DEMO_SAFETY_STAFF_PASSWORD=

# Applicant verification codes. Applicant cookie lifetime is 1 hour; challenge lifetime is 10 minutes.
# EMAIL_DELIVERY=none: local CLI only (npm run verification:demo -- <reference>, example.test addresses);
#   production verification fails closed.
# EMAIL_DELIVERY=smtp: real delivery to any address. See docs/email-delivery.md.
#   Production/Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<sending mailbox>,
#   SMTP_PASSWORD=<app password, set only in the host's secret settings>.
#   Local Mailpit inbox (development only): SMTP_HOST=localhost, SMTP_PORT=1025, no user/password.
EMAIL_DELIVERY=none
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Sender of staff two-step verification codes: a different address (for example a "Send mail as" alias of the SMTP
# mailbox). Email codes are offered only when it is set.
STAFF_EMAIL_FROM=

# Applicant photos and signed documents (see docs/onboarding-documents.md).
# none = not collected (development only); local = fictional files in a Git-ignored folder (development/tests);
# gcs = private Google Cloud Storage bucket, required by the production API. The service-account JSON key is
# base64-encoded and set only in the host's secret settings, never in a file.
STORAGE_DRIVER=none
STORAGE_LOCAL_DIR=
GCS_BUCKET=
GCS_CREDENTIALS_BASE64=

# Staff two-step verification: 32 random bytes as base64 (npm run setup:local generates one).
# Required by the production API; changing it makes enrolled authenticators unreadable.
MFA_ENCRYPTION_KEY=
# 32 random bytes as base64; encrypts driver SSNs. Without it SSN entry is unavailable. Changing it makes stored SSNs unreadable.
PII_ENCRYPTION_KEY=

# Applicant status updates by Telegram (see docs/applicant-updates.md). none (default) or bot.
# Outside production TELEGRAM_API_BASE may only point at a local fake server; production uses the real Bot API.
TELEGRAM_DELIVERY=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional one-time first administrator CLI (never startup/build/seed).
# Password is entered twice at a hidden interactive prompt, never in env/arguments.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# local for development; hosted deployments use production, or staging for the staff test copy (see docs/staging.md).
DEPLOYMENT_PURPOSE=local
