{
  "name": "operations-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@operations/web",
    "dev:api": "npm run dev --workspace=@operations/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "migration:run": "npm run migration:run --workspace=@operations/api",
    "migration:revert": "npm run migration:revert --workspace=@operations/api",
    "migration:generate": "npm run migration:generate --workspace=@operations/api --",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:demo": "npm run seed:demo --workspace=@operations/api",
    "verification:demo": "npm run verification:demo --workspace=@operations/api --",
    "admin:bootstrap": "npm run admin:bootstrap --workspace=@operations/api",
    "predev": "node scripts/check-node.cjs",
    "postinstall": "node scripts/repair-native.cjs",
    "repair:native": "node scripts/repair-native.cjs",
    "setup:dependencies": "node scripts/repair-native.cjs --install",
    "demo:retire-database": "npm run demo:retire-database --workspace=@operations/api --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "@eslint/js": "^9.39.0"
  },
  "overrides": {
    "multer": "^2.5.0",
    "body-parser": "^2.4.0",
    "path-to-regexp@8": "^8.4.2",
    "js-yaml@4": "^4.3.2",
    "uuid": "^11.1.1",
    "js-yaml@5": "^5.5.0"
  }
}
